{
  "name": "OwnershipSecret",
  "type": "object",
  "properties": {
    "lost_report_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "secret_detail": {
      "type": "string"
    }
  },
  "required": [
    "lost_report_id",
    "owner_id",
    "secret_detail"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}