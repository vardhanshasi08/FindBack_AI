{
  "name": "AIMatch",
  "type": "object",
  "properties": {
    "lost_report_id": {
      "type": "string"
    },
    "found_report_id": {
      "type": "string"
    },
    "lost_report_code": {
      "type": "string"
    },
    "found_report_code": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "finder_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "found_item_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "gemini_score": {
      "type": "number"
    },
    "deterministic_score": {
      "type": "number"
    },
    "explanation": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "dimensions": {
      "type": "object"
    },
    "processing_status": {
      "type": "string",
      "default": "completed"
    },
    "error_message": {
      "type": "string"
    },
    "is_qualifying": {
      "type": "boolean",
      "default": false
    },
    "owner_response": {
      "type": "string",
      "default": "none"
    },
    "owner_note": {
      "type": "string"
    },
    "responded_at": {
      "type": "string"
    },
    "notified": {
      "type": "boolean",
      "default": false
    },
    "final_status": {
      "type": "string"
    },
    "finalized_at": {
      "type": "string"
    }
  },
  "required": [
    "lost_report_id",
    "found_report_id",
    "owner_id",
    "finder_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.finder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}